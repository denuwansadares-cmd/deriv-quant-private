# Demo-only owner configuration. Never commit real credentials.
# Register and use your own Deriv application.
DERIV_APP_ID=your_deriv_app_id
# OAuth access token or PAT bearer token. DERIV_PAT remains a legacy alias.
DERIV_ACCESS_TOKEN=your_deriv_access_token
# Legacy DERIV_PAT is read only when DERIV_ACCESS_TOKEN is absent.
DERIV_MODE=demo
DERIV_SYMBOLS=R_10,1HZ10V,R_25,1HZ25V,R_50,1HZ50V,R_75,1HZ75V,R_100,1HZ100V
# Rise/Fall expiry in minutes (accepted range: 1-60).
DERIV_RISE_FALL_DURATION_MINUTES=1
# Optional: 0 or unset runs continuously; a positive value stops demo mode after that many seconds.
DEMO_DURATION_SECS=0
# $50-bankroll plan: $1-$3 signal-scaled stake, $5 session stop, one open contract.
DERIV_MAX_STAKE_MINOR=300
DERIV_SESSION_LOSS_LIMIT_BPS=1000
DERIV_MAX_OPEN_EXPOSURE_BPS=600
DERIV_MAX_OPEN_CONTRACTS=1
# Stop persistently after this many consecutive losses. Requires manual review/reset.
DERIV_MAX_CONSECUTIVE_LOSSES=3
# Loss cooldown doubles after each consecutive loss, capped at one hour.
DERIV_LOSS_COOLDOWN_BASE_SECS=60
# Optional operator-held history. Keep Deriv's retention confirmation as evidence;
# redistribution/transfer requires separate permission. Never use data/api-records.
HISTORY_PATH=/history/normalized
# Only raw/ephemeral API segments belong here and expire after 24h. Raw capture is disabled by default.
DERIV_API_RECORDS_DIR=data/api-records
# Normalized permitted metadata journal; not subject to raw-record TTL.
DERIV_AUDIT_JOURNAL_DIR=data/audit
# Persistent stop/heartbeat/runtime lock directory. Mount this in containers.
DERIV_RISK_STATE_DIR=.risk
# Dashboard defaults to loopback. Remote exposure requires a TLS reverse proxy.
DERIV_DASHBOARD_BIND=127.0.0.1:8080
# Emergency stop is disabled unless a 32+ character temporary token and Unix expiry are supplied.
DERIV_DASHBOARD_TOKEN=
DERIV_DASHBOARD_CSRF_TOKEN=
DERIV_DASHBOARD_TOKEN_EXPIRES_UNIX=
RUST_LOG=info
